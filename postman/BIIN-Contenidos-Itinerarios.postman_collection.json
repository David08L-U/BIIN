                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.filter(b => b.idRegistro === String(pm.environment.get('idNegocioCreado'))).map(b => b.accion);",
                  "pm.test('Registra crear, publicar y archivar', () => ['crear','publicar','archivar'].forEach(a => pm.expect(ids).to.include(a)));"
