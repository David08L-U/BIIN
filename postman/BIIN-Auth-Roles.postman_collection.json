              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea usuario operador (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('idUsuarioCreado', String(body.idUsuario));",
                  "pm.test('Conserva viajero y asigna operador', () => {",
                  "  pm.expect(body.roles).to.include('viajero');",
                  "  pm.expect(body.roles).to.include('operador');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Operador Postman {{$timestamp}}\",\n  \"correo\": \"operador.{{$timestamp}}@biin.test\",\n  \"contrasena\": \"Operador1234\",\n  \"roles\": [\"operador\"],\n  \"idRutas\": [{{idRutaDemo}}]\n}"
            },
            "url": "{{baseUrl}}/api/admin/usuarios"
          }
        },
        {
          "name": "Detalle del usuario creado (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Obtiene detalle (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": "{{baseUrl}}/api/admin/usuarios/{{idUsuarioCreado}}"
          }
        },
        {
          "name": "Actualizar rutas del operador (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza operador_ruta (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idRutas\": [{{idRutaDemo}}]\n}"
            },
            "url": "{{baseUrl}}/api/admin/usuarios/{{idUsuarioCreado}}/rutas"
          }
        },
        {
          "name": "Quitar rol operador (200, limpia rutas y conserva viajero)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza roles (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Conserva viajero y limpia rutasOperadas', () => {",
                  "  pm.expect(body.roles).to.eql(['viajero']);",
                  "  pm.expect(body.rutasOperadas).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": []\n}"
            },
            "url": "{{baseUrl}}/api/admin/usuarios/{{idUsuarioCreado}}/roles"
          }
        },
        {
          "name": "Desactivar cuenta (retiro lógico, 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Desactiva usuario (200)', () => pm.response.to.have.status(200));",
                  "pm.test('activo queda en false', () => pm.expect(pm.response.json().activo).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activo\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/usuarios/{{idUsuarioCreado}}/estado"
          }
        },
        {
          "name": "Reactivar cuenta (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reactiva usuario (200)', () => pm.response.to.have.status(200));",
                  "pm.test('activo queda en true', () => pm.expect(pm.response.json().activo).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activo\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/usuarios/{{idUsuarioCreado}}/estado"
          }
        }
      ]
    }
  ]
}
