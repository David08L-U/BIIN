    {
      "name": "0. Salud (Público / RF01)",
      "item": [
        {
          "name": "Estado de API y PostgreSQL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('API y BD conectadas con 4 roles', () => {",
                  "  pm.expect(body.api).to.eql('ok');",
                  "  pm.expect(body.baseDeDatos).to.eql('ok');",
                  "  pm.expect(body.roles).to.be.at.least(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/salud"
          }
        }
      ]
    },
