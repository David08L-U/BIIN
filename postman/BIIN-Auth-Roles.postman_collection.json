              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea cuenta (201) o ya existe (409 en re-ejecución)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('tokenViajero', body.token);",
                  "  pm.test('Asigna únicamente rol viajero', () => {",
